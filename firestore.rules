rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Logic Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 👤 Users Collection
    match /users/{userId} {
      // Anyone signed in can read a user's trust profile
      allow read: if isSignedIn();
      
      // Creating initial user profile (enforce safe initial values)
      allow create: if isOwner(userId)
        && request.resource.data.trustScore is number
        && request.resource.data.trustScore <= 4.0
        && request.resource.data.isSuspended == false
        && request.resource.data.canCreate == true
        && request.resource.data.hangsCompleted == 0
        && request.resource.data.noShows == 0;

      // Updating user profile: Users CANNOT self-grant trust score, bypass suspensions, or forge stats
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'trustScore', 
          'isSuspended', 
          'canCreate', 
          'hangsCompleted', 
          'noShows', 
          'totalRatings'
        ]);

      allow delete: if isOwner(userId);
    }

    // 🥂 Hangouts Collection
    match /hangouts/{hangoutId} {
      // All authenticated users can see available hangouts
      allow read: if isSignedIn();
      
      // Creating a hangout (Host must match authenticated user with sane bounds)
      allow create: if isSignedIn() 
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.title is string 
        && request.resource.data.title.size() > 0 
        && request.resource.data.title.size() <= 120
        && request.resource.data.maxParticipants is int
        && request.resource.data.maxParticipants >= 2
        && request.resource.data.maxParticipants <= 200
        && request.resource.data.status in ['active', 'full'];
        
      // Updating a hangout
      allow update: if isSignedIn() && (
        // Case 1: Host can update event details or cancel
        request.auth.uid == resource.data.hostId
        ||
        // Case 2: Non-host can ONLY join or leave (adding or removing their own UID)
        (
          // Only participantIds and status can be affected
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantIds', 'status'])
          // Non-hosts cannot cancel or mark as completed
          && request.resource.data.status in ['active', 'full']
          // Cannot exceed capacity
          && request.resource.data.participantIds.size() <= resource.data.maxParticipants
          // The difference in participants must ONLY involve the caller's own uid
          && (
            // User joins: adds their own uid
            (
              !resource.data.participantIds.hasAny([request.auth.uid])
              && request.resource.data.participantIds.hasAll(resource.data.participantIds)
              && request.resource.data.participantIds.hasAny([request.auth.uid])
              && request.resource.data.participantIds.size() == resource.data.participantIds.size() + 1
            )
            ||
            // User leaves: removes their own uid
            (
              resource.data.participantIds.hasAny([request.auth.uid])
              && !request.resource.data.participantIds.hasAny([request.auth.uid])
              && resource.data.participantIds.hasAll(request.resource.data.participantIds)
              && request.resource.data.participantIds.size() == resource.data.participantIds.size() - 1
            )
          )
        )
      );
        
      allow delete: if false; // Deletion not allowed, use 'cancelled' status
    }

    // ⭐ Ratings Collection
    match /ratings/{ratingId} {
      allow read: if isSignedIn();
      // Enforce valid score range (1-5), prevent self-rating, ensure creator is caller
      allow create: if isSignedIn() 
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.score is number
        && request.resource.data.score >= 1.0 
        && request.resource.data.score <= 5.0
        && request.resource.data.hangoutId is string
        && request.resource.data.hangoutId.size() > 0;
      allow update, delete: if false;
    }

    // ⚠️ Reports Collection
    match /reports/{reportId} {
      allow create: if isSignedIn() 
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.reason is string;
      allow read, update, delete: if false; // Only manageable via Admin SDK/Console
    }

    // 🎟️ Participations Collection (Associative Entity)
    match /participations/{participationId} {
      allow read: if isSignedIn();
      // Only the enrolling user can create their participation
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.hangoutId is string
        && request.resource.data.status in ['confirmed'];
      // User can cancel their own participation, or Host can update attendance
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid
        || request.auth.uid == get(/databases/$(database)/documents/hangouts/$(resource.data.hangoutId)).data.hostId
      );
      allow delete: if false;
    }

    // 📜 Audit Logs (Append-Only Immutable Ledger)
    match /audit_logs/{logId} {
      allow read: if false; // Secret audit trail for fraud investigation
      allow create: if isSignedIn() 
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.action is string;
      allow update, delete: if false;
    }
  }
}
